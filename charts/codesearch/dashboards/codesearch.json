          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "codesearch_repo_index_consecutive_failures{job=\"$job\", namespace=\"$namespace\", repo=~\"$repo\"}",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
